{
  "name": "av-arsenal",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "AV-arsenal inventory and calendar-based equipment planning",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "audit:export": "node tools/audit-export.mjs",
    "format": "prettier --write src tests tools package.json tsconfig.json",
    "format:check": "prettier --check src tests tools package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "firebase": "12.18.0",
    "jsqr": "1.4.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
