{
  "rules": {
    ".read": false,
    ".write": false,
    "allowedUsers": { ".read": false, ".write": false },
    "inventory": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true"
    },
    "keikat": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true"
    },
    "archived-trips": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true"
    },
    "shelves": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true"
    },
    "todo": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true"
    },
    "avArsenalV2": {
      "state": {
        ".read": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true && newData.exists()",
        ".validate": "newData.hasChildren(['schemaVersion','revision']) && newData.child('schemaVersion').val() == 2 && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() == 1) || newData.child('revision').val() == data.child('revision').val() + 1)",
        "products": {"$id": {".validate": "newData.hasChildren(['id','name','total','maintenance','tracking','version']) && newData.child('id').val() == $id && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('maintenance').isNumber() && newData.child('maintenance').val() >= 0 && (newData.child('tracking').val() == 'serial' || newData.child('tracking').val() == 'quantity')"}},
        "trips": {"$id": {".validate": "newData.hasChildren(['id','name','start','end','status','version']) && newData.child('id').val() == $id && newData.child('name').isString() && newData.child('version').isNumber() && newData.child('start').isString() && newData.child('end').isString()"}}
      }
    }
  }
}
